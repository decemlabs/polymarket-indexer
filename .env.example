# Target wallet address to index and verify
WALLET=0x46b353667fd7d846af3bbeda6584b0e5b883d3de

# Database connection URL
# SQLite:
DATABASE_URL=sqlite://polymarket.db
# PostgreSQL (optional):
# DATABASE_URL=postgres://user:password@localhost:5432/polymarket

# Comma-separated list of Polygon mainnet RPC endpoints (archive and full nodes)
POLYGON_RPC_URLS=https://polygon.gateway.tenderly.co,https://gateway.tenderly.co/public/polygon,https://polygon.drpc.org,https://rpc-mainnet.matic.quiknode.pro,https://matic.rpc.sentio.xyz,https://polygon-bor-rpc.publicnode.com,https://polygon.publicnode.com,https://polygon-bor.publicnode.com,https://rpc.private.mev-x.com/polygon,https://1rpc.io/matic

# Scanner performance and concurrency
SCANNER_CONCURRENCY=8
CHUNK_SIZE=25000
MAX_CHUNK_SIZE=50000

# Normalizer performance and concurrency
NORMALIZER_CONCURRENCY=8
NORMALIZER_CHUNK_SIZE=100000

# Optional starting block (if omitted, auto-detected from first wallet activity)
# START_BLOCK=80813662
